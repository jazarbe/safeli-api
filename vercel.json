{
  "version": 2,
  "builds": [
    {
      "src": "index.js", 
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["zonas_peligrosas.geojson"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "destination": "index.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    }
  ]
}